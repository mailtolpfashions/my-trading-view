{
  "name": "@mtv/db",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "scripts": {
    "start": "node scripts/dev-db.mjs",
    "generate": "dotenv -e ../../.env -- prisma generate",
    "migrate": "dotenv -e ../../.env -- prisma migrate dev",
    "deploy": "dotenv -e ../../.env -- prisma migrate deploy",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@prisma/client": "^6.19.3"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "dotenv-cli": "^8.0.0",
    "embedded-postgres": "^18.4.0-beta.17",
    "pg": "^8.23.1",
    "prisma": "^6.19.3",
    "typescript": "^5.9.3"
  }
}
