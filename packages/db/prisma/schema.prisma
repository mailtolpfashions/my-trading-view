generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---- Accounts (better-auth tables) ----

model User {
  id            String         @id
  name          String
  email         String         @unique
  emailVerified Boolean        @default(false)
  image         String?
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  sessions      Session[]
  accounts      Account[]
  subscriptions Subscription[]
  payments      Payment[]
  liveUsage     LiveUsage[]
  paperAccount  PaperAccount?
  alerts        Alert[]
  alertEvents   AlertEvent[]

  @@map("user")
}

model Session {
  id        String   @id
  expiresAt DateTime
  token     String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  ipAddress String?
  userAgent String?
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("session")
}

model Account {
  id                    String    @id
  accountId             String
  providerId            String
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@map("account")
}

model Verification {
  id         String   @id
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@map("verification")
}

// ---- Subscriptions ----

model Subscription {
  id                     String    @id @default(cuid())
  userId                 String
  user                   User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  plan                   String // LIVE
  interval               String // month | year
  /// PENDING (checkout started) | ACTIVE | HALTED (payment failed) | CANCELLED
  status                 String
  provider               String // billing-sandbox | razorpay
  providerSubscriptionId String    @unique
  /// Paid access lasts until this moment, even after cancelling.
  currentPeriodEnd       DateTime?
  cancelAtPeriodEnd      Boolean   @default(false)
  createdAt              DateTime  @default(now())
  updatedAt              DateTime  @updatedAt

  @@index([userId, status])
}

model Payment {
  id          String   @id @default(cuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  provider    String
  /// The provider's payment id; unique so a webhook delivered twice records one payment.
  paymentId   String   @unique
  amountPaise Int
  currency    String
  createdAt   DateTime @default(now())
}

/// One row per user per month in which they received live (real-time) data: the basis for exchange per-user fees.
model LiveUsage {
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  month     String // YYYY-MM (IST)
  firstSeen DateTime @default(now())

  @@id([userId, month])
}

// Paper trading. Money is stored as integer paise (BigInt) and positions/cash are never stored:
// they are rebuilt from PaperTrade rows, so balances cannot drift from the trade history.

model PaperAccount {
  id                String       @id @default(cuid())
  /// Owner. Null only for the single pre-accounts paper account created during development.
  userId            String?      @unique
  user              User?        @relation(fields: [userId], references: [id], onDelete: Cascade)
  name              String       @default("Paper account")
  startingCashPaise BigInt
  createdAt         DateTime     @default(now())
  resetAt           DateTime     @default(now())
  orders            PaperOrder[]
  trades            PaperTrade[]
}

model PaperOrder {
  id           String       @id @default(cuid())
  accountId    String
  account      PaperAccount @relation(fields: [accountId], references: [id], onDelete: Cascade)
  symbol       String
  side         String // BUY | SELL
  product      String // CNC | MIS
  type         String // MARKET | LIMIT | SL | SLM
  qty          Int
  pricePaise   BigInt?
  triggerPaise BigInt?
  /// OPEN | TRIGGER_PENDING | COMPLETE | CANCELLED | REJECTED
  status       String
  triggered    Boolean      @default(false)
  avgFillPaise BigInt?
  rejectReason String?
  /// Set on system orders, e.g. AUTO_SQUAREOFF for intraday positions closed at the square-off time, EXPIRY
  tag          String?
  /// Trade lab: NSE (stocks) or NFO (futures and options); `symbol` is the exchange's trading symbol
  exchange     String       @default("NSE")
  /// Units per lot for F&O (orders are whole lots); null for stocks
  lotSize      Int?
  /// The entry order this exit belongs to (stop and target legs of a bracket: one fills, the other is cancelled)
  parentId     String?
  /// Bracket levels on an entry order: once it fills, a stop and a target exit are placed
  stopPaise    BigInt?
  targetPaise  BigInt?
  /// MANUAL, or AUTO:<rule id> for orders placed by an automatic rule
  source       String       @default("MANUAL")
  /// Why the order was placed or how it ended, in plain words (fills at bid/ask, square-off, rejections)
  reason       String?
  /// IST trading date, YYYY-MM-DD
  tradeDate    String
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt
  trade        PaperTrade?

  @@index([accountId, status])
}

// NSE cash-market end-of-day data (official bhavcopy), every stock, as published: prices are NOT adjusted for
// splits or bonuses. Adjustment factors are derived from NSE's own previous-close column (see apps/feed/src/eod).

model EquityEod {
  date           String // trading date, YYYY-MM-DD
  symbol         String
  isin           String
  series         String // EQ | BE | BZ
  openPaise      Int
  highPaise      Int
  lowPaise       Int
  closePaise     Int
  /// NSE's previous close for this day: differs from the prior day's close only after a corporate action.
  prevClosePaise Int
  volume         BigInt
  trades         Int?

  @@id([date, symbol])
  @@index([symbol, date])
  @@index([isin])
}

/// NSE index closes (ind_close_all), keyed by NSE's index name.
model IndexEod {
  date       String
  name       String // e.g. NIFTY 50
  openPaise  Int
  highPaise  Int
  lowPaise   Int
  closePaise Int

  @@id([date, name])
}

/// NSE's corporate-action file (Bc, in the daily PR bundle), as published. Used to adjust prices for splits and bonuses.
model CorporateAction {
  symbol     String
  exDate     String // YYYY-MM-DD
  purpose    String
  series     String
  recordDate String?
  /// Trading day of the NSE file in which this row was first seen.
  firstSeen  String

  @@id([symbol, exDate, purpose])
  @@index([exDate])
}

/// One row per date attempted for the cash-market history, so no file is downloaded twice.
model EodFetch {
  date      String   @id
  /// saved | not-published | error
  status    String
  message   String?
  attempts  Int      @default(1)
  updatedAt DateTime @updatedAt
}

// ---- Alerts: price and indicator alerts per user ----

model Alert {
  id              String       @id @default(cuid())
  userId          String
  user            User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  symbol          String
  /// PRICE | RULES
  kind            String
  /// PRICE: { op: crossesAbove | crossesBelow, valuePaise }. RULES: { tf, rules } (a backtest RuleSet).
  params          Json
  note            String?
  /// ACTIVE | PAUSED | TRIGGERED
  status          String
  /// once: stops after firing. every: fires again on the next crossing (PRICE) or the next bar (RULES).
  repeat          String       @default("once")
  lastTriggeredAt DateTime?
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt
  events          AlertEvent[]

  @@index([status])
  @@index([userId])
}

model AlertEvent {
  id          String    @id @default(cuid())
  alertId     String
  alert       Alert     @relation(fields: [alertId], references: [id], onDelete: Cascade)
  userId      String
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  triggeredAt DateTime  @default(now())
  /// The price (or bar close) that triggered the alert, in paise, and its market time (delayed for Free users).
  pricePaise  Int
  marketTime  DateTime
  message     String
  /// sent | not_configured | failed
  emailStatus String
  seenAt      DateTime?

  @@index([userId, triggeredAt])
}

// ---- Signals: published rule-based strategies and every signal they ever issued ----

/// A published strategy version. Rules never change after publishing: a change is a new version.
model SignalStrategy {
  /// slug@version, e.g. breakout-52w@1
  id          String        @id
  slug        String
  version     Int
  name        String
  description String
  /// The exact rules (a backtest Strategy), as published.
  rules       Json
  /// SHA-256 of the rules JSON, to prove they never changed.
  rulesHash   String
  publishedAt DateTime      @default(now())
  retiredAt   DateTime?
  issues      SignalIssue[]

  @@unique([slug, version])
}

/// One signal, recorded the evening it was issued. Append-only: rows are never edited or deleted.
model SignalIssue {
  id         String         @id @default(cuid())
  strategyId String
  strategy   SignalStrategy @relation(fields: [strategyId], references: [id])
  /// The trading day whose close produced the signal (YYYY-MM-DD); it acts at the next session's open.
  date       String
  symbol     String
  /// ENTER | EXIT
  action     String
  /// That day's official close, as traded (not adjusted).
  closePaise Int
  issuedAt   DateTime       @default(now())

  @@unique([strategyId, date, symbol, action])
  @@index([date])
}

// NSE F&O end-of-day data (official bhavcopy) for index derivatives. Prices in integer paise.

model FnoEod {
  date        String // trading date, YYYY-MM-DD
  underlying  String // NSE F&O symbol: NIFTY, BANKNIFTY, FINNIFTY, … or a stock such as RELIANCE
  kind        String // FUT | CE | PE
  expiry      String // YYYY-MM-DD
  /// Strike in paise (0 for futures)
  strikePaise Int
  openPaise   Int
  highPaise   Int
  lowPaise    Int
  /// NSE's close. For an untraded contract this is carried forward, not a traded price: check `traded`.
  closePaise  Int
  settlePaise Int
  oi          BigInt
  volume      BigInt
  traded      Boolean

  @@id([date, underlying, kind, expiry, strikePaise])
  @@index([underlying, expiry, kind, strikePaise])
}

model FnoDayMeta {
  date       String
  underlying String
  /// Lot size that day (from the file, or derived from futures turnover for the old layout; null if ambiguous)
  lotSize    Int?
  /// Underlying index close in paise (from the file, or NSE's official index-close file)
  spotPaise  Int?
  source     String // udiff | old
  /// Index derivative (true) or stock derivative (false)
  isIndex    Boolean  @default(true)
  fetchedAt  DateTime @default(now())

  @@id([date, underlying])
  @@index([underlying, date])
}

/// Statistics of one expiry's option chain on one day, computed from that day's NSE F&O file when it is saved
/// (apps/feed/src/fno/derive.ts). IV and gamma are model estimates (Black-76 on the put-call-parity forward).
model FnoDerivedDay {
  date            String
  underlying      String
  expiry          String
  /// Calendar days from date to expiry
  daysToExpiry    Int
  /// Lot size of this expiry's contracts (differs between expiries while NSE moves to a new lot size)
  lotSize         Int?
  spotPaise       Int?
  forwardPaise    Int?
  strikeStepPaise Int?
  /// Listed strike nearest the forward (or spot when no forward)
  atmStrikePaise  Int?
  atmIv           Float?
  /// ATM call close + put close; traded = both legs traded that day
  straddlePaise   Int?
  straddleTraded  Boolean  @default(false)
  maxPainPaise    Int?
  /// Open interest in shares and volume in contracts, as NSE publishes them
  ceOi            BigInt
  peOi            BigInt
  ceVolume        BigInt
  peVolume        BigInt
  /// Net gamma exposure, rupees per 1% move (calls +, puts −)
  gexNet          Float?
  callWallPaise   Int?
  putWallPaise    Int?
  gammaFlipPaise  Int?
  /// Legs with open interest but no trade, whose IV was interpolated for gamma exposure
  gexIvFilled     Int      @default(0)

  @@id([date, underlying, expiry])
  @@index([underlying, date])
}

/// One row per date attempted, so holidays and finished days are never downloaded twice.
/// NSE participant-wise open interest ('oi') and trading volume ('vol') in equity derivatives, in contracts, as
/// published daily (content/nsccl/fao_participant_*). participant: Client | DII | FII | Pro.
model ParticipantOi {
  date            String
  kind            String
  participant     String
  futIdxLong      BigInt
  futIdxShort     BigInt
  futStkLong      BigInt
  futStkShort     BigInt
  optIdxCallLong  BigInt
  optIdxPutLong   BigInt
  optIdxCallShort BigInt
  optIdxPutShort  BigInt
  optStkCallLong  BigInt
  optStkPutLong   BigInt
  optStkCallShort BigInt
  optStkPutShort  BigInt
  totalLong       BigInt
  totalShort      BigInt

  @@id([date, kind, participant])
}

/// NSE daily FII derivatives statistics (content/fo/fii_stats_*.xls): buy, sell and end-of-day open interest, in
/// contracts and ₹ crore, per segment as NSE names it (INDEX FUTURES, NIFTY OPTIONS, STOCK FUTURES, …).
model FiiDerivStat {
  date          String
  segment       String
  buyContracts  BigInt
  buyCr         Decimal @db.Decimal(18, 4)
  sellContracts BigInt
  sellCr        Decimal @db.Decimal(18, 4)
  oiContracts   BigInt
  oiCr          Decimal @db.Decimal(18, 4)

  @@id([date, segment])
}

/// NSDL "Daily Trends in FPI Investments": FPI gross purchases, sales and net investment (₹ crore, US$ mn) per
/// asset class and route. reportDate is NSDL's reporting date (trades of the previous trading day(s)).
model FpiFlow {
  reportDate String
  category   String
  route      String
  purchaseCr Decimal  @db.Decimal(18, 2)
  salesCr    Decimal  @db.Decimal(18, 2)
  netCr      Decimal  @db.Decimal(18, 2)
  netUsdMn   Decimal  @db.Decimal(18, 2)
  usdInr     Decimal? @db.Decimal(10, 4)

  @@id([reportDate, category, route])
}

/// One row per date attempted for FII statistics files.
model FiiStatFetch {
  date      String   @id
  /// saved | not-published | error
  status    String
  message   String?
  attempts  Int      @default(1)
  updatedAt DateTime @updatedAt
}

/// One row per date attempted for participant files, so none is downloaded twice.
model ParticipantFetch {
  date      String   @id
  /// saved | not-published | error
  status    String
  message   String?
  attempts  Int      @default(1)
  updatedAt DateTime @updatedAt
}

model FnoFetch {
  date      String   @id
  /// saved | not-published | error
  status    String
  /// What was saved: 'index' (all index F&O) or 'all' (index and stock F&O). Null: only NIFTY and BANKNIFTY (before
  /// 2 Nov 2026), so the day is downloaded again.
  scope     String?
  message   String?
  attempts  Int      @default(1)
  updatedAt DateTime @updatedAt
}

model PaperTrade {
  id           String       @id @default(cuid())
  /// One fill per order (no partial fills in the simulation); unique so an order can never fill twice.
  orderId      String       @unique
  order        PaperOrder   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  accountId    String
  account      PaperAccount @relation(fields: [accountId], references: [id], onDelete: Cascade)
  symbol       String
  side         String
  product      String
  qty          Int
  pricePaise   BigInt
  chargesPaise BigInt
  /// Itemised charges (brokerage, STT, exchange, SEBI, stamp, GST, DP) in paise
  charges      Json
  /// NSE (stocks) or NFO (futures and options)
  exchange     String       @default("NSE")
  time         DateTime
  tradeDate    String

  @@index([accountId, time])
}
