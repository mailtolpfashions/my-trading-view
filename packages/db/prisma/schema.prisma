generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---- Accounts (better-auth tables) ----

model User {
  id            String         @id
  name          String
  email         String         @unique
  emailVerified Boolean        @default(false)
  image         String?
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  sessions      Session[]
  accounts      Account[]
  subscriptions Subscription[]
  payments      Payment[]
  liveUsage     LiveUsage[]
  paperAccount  PaperAccount?

  @@map("user")
}

model Session {
  id        String   @id
  expiresAt DateTime
  token     String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  ipAddress String?
  userAgent String?
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("session")
}

model Account {
  id                    String    @id
  accountId             String
  providerId            String
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@map("account")
}

model Verification {
  id         String   @id
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@map("verification")
}

// ---- Subscriptions ----

model Subscription {
  id                     String    @id @default(cuid())
  userId                 String
  user                   User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  plan                   String // LIVE
  interval               String // month | year
  /// PENDING (checkout started) | ACTIVE | HALTED (payment failed) | CANCELLED
  status                 String
  provider               String // billing-sandbox | razorpay
  providerSubscriptionId String    @unique
  /// Paid access lasts until this moment, even after cancelling.
  currentPeriodEnd       DateTime?
  cancelAtPeriodEnd      Boolean   @default(false)
  createdAt              DateTime  @default(now())
  updatedAt              DateTime  @updatedAt

  @@index([userId, status])
}

model Payment {
  id          String   @id @default(cuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  provider    String
  /// The provider's payment id; unique so a webhook delivered twice records one payment.
  paymentId   String   @unique
  amountPaise Int
  currency    String
  createdAt   DateTime @default(now())
}

/// One row per user per month in which they received live (real-time) data: the basis for exchange per-user fees.
model LiveUsage {
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  month     String // YYYY-MM (IST)
  firstSeen DateTime @default(now())

  @@id([userId, month])
}

// Paper trading. Money is stored as integer paise (BigInt) and positions/cash are never stored:
// they are rebuilt from PaperTrade rows, so balances cannot drift from the trade history.

model PaperAccount {
  id                String       @id @default(cuid())
  /// Owner. Null only for the single pre-accounts paper account created during development.
  userId            String?      @unique
  user              User?        @relation(fields: [userId], references: [id], onDelete: Cascade)
  name              String       @default("Paper account")
  startingCashPaise BigInt
  createdAt         DateTime     @default(now())
  resetAt           DateTime     @default(now())
  orders            PaperOrder[]
  trades            PaperTrade[]
}

model PaperOrder {
  id           String       @id @default(cuid())
  accountId    String
  account      PaperAccount @relation(fields: [accountId], references: [id], onDelete: Cascade)
  symbol       String
  side         String // BUY | SELL
  product      String // CNC | MIS
  type         String // MARKET | LIMIT | SL | SLM
  qty          Int
  pricePaise   BigInt?
  triggerPaise BigInt?
  /// OPEN | TRIGGER_PENDING | COMPLETE | CANCELLED | REJECTED
  status       String
  triggered    Boolean      @default(false)
  avgFillPaise BigInt?
  rejectReason String?
  /// Set on system orders, e.g. AUTO_SQUAREOFF for intraday positions closed at 15:20 IST
  tag          String?
  /// IST trading date, YYYY-MM-DD
  tradeDate    String
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt
  trade        PaperTrade?

  @@index([accountId, status])
}

// NSE F&O end-of-day data (official bhavcopy) for index derivatives. Prices in integer paise.

model FnoEod {
  date        String // trading date, YYYY-MM-DD
  underlying  String // NIFTY | BANKNIFTY
  kind        String // FUT | CE | PE
  expiry      String // YYYY-MM-DD
  /// Strike in paise (0 for futures)
  strikePaise Int
  openPaise   Int
  highPaise   Int
  lowPaise    Int
  /// NSE's close. For an untraded contract this is carried forward, not a traded price: check `traded`.
  closePaise  Int
  settlePaise Int
  oi          BigInt
  volume      BigInt
  traded      Boolean

  @@id([date, underlying, kind, expiry, strikePaise])
  @@index([underlying, expiry, kind, strikePaise])
}

model FnoDayMeta {
  date       String
  underlying String
  /// Lot size that day (from the file, or derived from futures turnover for the old layout; null if ambiguous)
  lotSize    Int?
  /// Underlying index close in paise (from the file, or NSE's official index-close file)
  spotPaise  Int?
  source     String // udiff | old
  fetchedAt  DateTime @default(now())

  @@id([date, underlying])
}

/// One row per date attempted, so holidays and finished days are never downloaded twice.
model FnoFetch {
  date      String   @id
  /// saved | not-published | error
  status    String
  message   String?
  attempts  Int      @default(1)
  updatedAt DateTime @updatedAt
}

model PaperTrade {
  id           String       @id @default(cuid())
  /// One fill per order (no partial fills in the simulation); unique so an order can never fill twice.
  orderId      String       @unique
  order        PaperOrder   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  accountId    String
  account      PaperAccount @relation(fields: [accountId], references: [id], onDelete: Cascade)
  symbol       String
  side         String
  product      String
  qty          Int
  pricePaise   BigInt
  chargesPaise BigInt
  /// Itemised charges (brokerage, STT, exchange, SEBI, stamp, GST, DP) in paise
  charges      Json
  time         DateTime
  tradeDate    String

  @@index([accountId, time])
}
