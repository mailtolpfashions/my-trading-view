# landing = publish only the home and legal pages (sign-up, terminal, pricing and APIs switched off). Leave empty for the full app.
SITE_MODE=

# Public site URL (used for metadata, sitemap and absolute links)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Contact address shown on the site and legal pages
NEXT_PUBLIC_CONTACT_EMAIL=support@mytradingview.in

# Feed service (apps/feed): port, and the URL browsers use to reach it
FEED_PORT=4001
NEXT_PUBLIC_FEED_URL=http://localhost:4001

# Zerodha Kite Connect: the owner's personal login, for internal research scripts only (the site shows no live data)
KITE_API_KEY=
KITE_API_SECRET=

# Database (local embedded Postgres via npm run db:start)
DATABASE_URL=postgresql://postgres:postgres@localhost:5434/mytradingview

# Accounts (better-auth): a long random secret, and the public site URL
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000

# Google sign-in (Google Cloud Console → APIs & Services → Credentials → OAuth client ID, type "Web application").
# Authorised redirect URI: <BETTER_AUTH_URL>/api/auth/callback/google. The Google button shows once both are set.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Free site: runs a day (backtests, studies, scans) for visitors who haven't signed in, per visitor and per IP address
VISITOR_DAILY_RUNS=5
VISITOR_DAILY_RUNS_PER_IP=20
# Set to 1 when the feed runs behind a reverse proxy, so visitor limits see the real IP address
TRUST_PROXY=
# 1 = show pricing, upgrades and checkout (paid plans launched). Empty = everything free.
NEXT_PUBLIC_PAID_PLANS=

# Shared by web and feed to sign/verify feed access tokens (long random secret)
FEED_TOKEN_SECRET=

# Billing: sandbox (no real money) | razorpay
BILLING_PROVIDER=sandbox
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
RAZORPAY_PLAN_LIVE_MONTH=
RAZORPAY_PLAN_LIVE_YEAR=

# Comma-separated emails allowed to open /admin pages
ADMIN_EMAILS=


# History backfill start dates (NSE archive). Defaults: EOD 2022-01-03, F&O 2023-11-01, participant OI 2012-01-02.
# EOD_BACKFILL_FROM=2011-06-22
# FNO_BACKFILL_FROM=2011-01-03
# PARTICIPANT_BACKFILL_FROM=2012-01-02

# FRED (US Federal Reserve data) API key for research series: free at fred.stlouisfed.org → My Account → API Keys
FRED_API_KEY=
